{
  "name": "admin-mobile-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "db:preflight": "pnpm --filter @growpath/db preflight",
    "db:migrate": "node scripts/with-env.mjs pnpm --filter @growpath/db migrate:up",
    "db:rollback": "node scripts/with-env.mjs pnpm --filter @growpath/db migrate:down",
    "seed": "pnpm --filter @growpath/db seed",
    "platform-admin": "pnpm --filter @growpath/db platform-admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@growpath/contracts": "workspace:*",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "eslint": "^9.13.0",
    "node-pg-migrate": "^7.7.1",
    "pg": "^8.13.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.1.3",
    "yaml": "^2.6.0"
  }
}
