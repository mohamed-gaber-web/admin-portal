# Copy to .env and fill in real values. .env is gitignored.
#
# Admin connection used by migration tooling and tests. The account needs
# CREATEDB rights because the tests create/drop throwaway databases.
#
# Point this at a database of your own (create it once with
# `CREATE DATABASE growpath_dev`), not at the `postgres` maintenance database —
# keeping application tables out of it means you can drop and recreate your dev
# data with a single DROP DATABASE.
DATABASE_URL=postgresql://postgres:password@localhost:5432/growpath_dev

# Redis, verified by the readiness probe at GET /health/ready (US-016).
#
# Optional locally: the local stack does not run Redis, so leaving this unset
# reports `redis: "not_configured"` and readiness still passes. In production
# (NODE_ENV=production) an unset REDIS_URL is a misconfiguration and readiness
# returns 503 — better a loud failure than a dependency nobody is checking.
#
# Azure Redis Cache is TLS-only, so staging and production use rediss://.
# REDIS_URL=redis://localhost:6379

# Origins allowed to call the API with credentials, comma-separated. Defaults to
# the Angular dev server. There is deliberately no wildcard: reflecting the
# caller's Origin alongside credentials lets any site a signed-in admin visits
# call this API as them.
# PORTAL_ORIGIN=http://localhost:4200

# Signing key for access tokens and MFA challenges (US-022). At least 32
# characters.
#
# Optional locally: unset falls back to a visibly fake development key and logs
# a warning. In production an unset value is fatal at startup — a silent
# fallback would make every token forgeable by anyone who has read the repo.
# AUTH_JWT_SECRET=

# Encryption key for stored MFA secrets (US-025). At least 32 characters.
#
# Unlike every other credential here, a TOTP secret is encrypted rather than
# hashed: the server has to reproduce it to check a code. That makes this key
# the boundary — with it, a database leak yields working second factors.
#
# Optional locally, fatal in production, same as AUTH_JWT_SECRET. Rotating it
# invalidates every existing enrolment: stored secrets stop decrypting, and
# every enrolled user must enrol again.
# AUTH_MFA_KEY=

# Set to false to log liveness/readiness probe requests at debug instead of info.
# Probes run every few seconds forever; an operator drowning in them can turn
# them down without losing the correlation-ID guarantee for real traffic.
# LOG_PROBE_REQUESTS=false
