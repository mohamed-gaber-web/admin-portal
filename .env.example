# Copy to .env and fill in real values. .env is gitignored.
#
# Admin connection used by migration tooling and tests. The account needs
# CREATEDB rights because the tests create/drop throwaway databases.
#
# Point this at a database of your own (create it once with
# `CREATE DATABASE growpath_dev`), not at the `postgres` maintenance database —
# keeping application tables out of it means you can drop and recreate your dev
# data with a single DROP DATABASE.
DATABASE_URL=postgresql://postgres:password@localhost:5432/growpath_dev

# Redis, verified by the readiness probe at GET /health/ready (US-016).
#
# Optional locally: the local stack does not run Redis, so leaving this unset
# reports `redis: "not_configured"` and readiness still passes. In production
# (NODE_ENV=production) an unset REDIS_URL is a misconfiguration and readiness
# returns 503 — better a loud failure than a dependency nobody is checking.
#
# Azure Redis Cache is TLS-only, so staging and production use rediss://.
# REDIS_URL=redis://localhost:6379

# Origins allowed to call the API with credentials, comma-separated. Defaults to
# the Angular dev server. There is deliberately no wildcard: reflecting the
# caller's Origin alongside credentials lets any site a signed-in admin visits
# call this API as them.
#
# The Ionic app's dev server needs listing too once it calls this API. Give it a
# port of its own -- it is a separate Angular app and would otherwise collide
# with the portal on 4200:
# PORTAL_ORIGIN=http://localhost:4200,http://localhost:8100
#
# Do NOT add capacitor://localhost or https://localhost for the sake of the
# mobile app on a device. It does not need them -- CapacitorHttp is enabled, so
# requests leave through the OS rather than the WebView and no CORS preflight
# happens at all. And those origins are not that app's: every Capacitor app on
# every device presents them, so allowlisting one allowlists all of them.

# Signing key for access tokens and MFA challenges (US-022). At least 32
# characters.
#
# Optional locally: unset falls back to a visibly fake development key and logs
# a warning. In production an unset value is fatal at startup — a silent
# fallback would make every token forgeable by anyone who has read the repo.
# AUTH_JWT_SECRET=

# Encryption key for stored MFA secrets (US-025). At least 32 characters.
#
# Unlike every other credential here, a TOTP secret is encrypted rather than
# hashed: the server has to reproduce it to check a code. That makes this key
# the boundary — with it, a database leak yields working second factors.
#
# Optional locally, fatal in production, same as AUTH_JWT_SECRET. Rotating it
# invalidates every existing enrolment: stored secrets stop decrypting, and
# every enrolled user must enrol again.
# AUTH_MFA_KEY=

# Encryption key for sealed service credentials (US-041). At least 32 characters.
#
# Today that means the D365 client secret on each environment. Encrypted rather
# than hashed for the same reason the MFA secret is: the API has to reproduce it
# to request a token from Entra, so a one-way digest is not available.
#
# This key is what the sprint's exit criterion — "no client secret is
# recoverable from the database alone" — actually rests on. Keep it out of the
# database's backups and out of anywhere a database dump would travel.
#
# Optional locally, fatal in production, same as AUTH_JWT_SECRET. Separate from
# AUTH_MFA_KEY on purpose: two keys mean two blast radii, and rotating this one
# invalidates stored D365 secrets without touching anybody's MFA enrolment.
# Rotating it makes every stored connection fail its next check until each
# secret is re-entered.
# SECRET_ENCRYPTION_KEY=

# Test seam only. Redirects D365 token requests at a local stub so the
# acceptance tests can exercise the live check without a real Entra directory.
#
# IGNORED IN PRODUCTION, and logged as an error if set there. This variable
# names the host every client secret would be presented to, which makes it the
# single most valuable one an attacker could set.
# D365_AUTHORITY_ORIGIN_OVERRIDE=http://127.0.0.1:9999

# Set to false to log liveness/readiness probe requests at debug instead of info.
# Probes run every few seconds forever; an operator drowning in them can turn
# them down without losing the correlation-ID guarantee for real traffic.
# LOG_PROBE_REQUESTS=false

# ── Email: invitations and password reset links ──────────────────────────────
#
# Unset (or EMAIL_PROVIDER=log), nothing is sent: a line is logged instead and
# the portal still shows every link for the operator to copy. Set a provider to
# deliver them. See DEPLOYMENT.md, "5. Email", for the Azure setup steps.
#
# The portal's public address. Every emailed link points here. Falls back to
# the first PORTAL_ORIGIN when unset.
# PORTAL_URL=https://<your>.vercel.app
#
# EMAIL_PROVIDER=graph            # graph | acs | smtp | log
# EMAIL_FROM=noreply@growpath.net # the mailbox (graph) or MailFrom address (acs)
# EMAIL_FROM_NAME=Grow Path
#
# graph: a Microsoft 365 mailbox, via an Entra app with Mail.Send (application).
# EMAIL_GRAPH_TENANT_ID=
# EMAIL_GRAPH_CLIENT_ID=
# EMAIL_GRAPH_CLIENT_SECRET=
#
# acs: Azure Communication Services Email. The connection string from the
# resource's Keys blade: endpoint=https://...communication.azure.com/;accesskey=...
# EMAIL_ACS_CONNECTION_STRING=
#
# smtp: any SMTP server (Gmail, Office 365, ACS SMTP). Chosen automatically
# when EMAIL_HOST is set and EMAIL_PROVIDER is not. Port 465 is implicit TLS,
# anything else upgrades with STARTTLS; EMAIL_SECURE=true|false overrides.
# EMAIL_FROM defaults to EMAIL_USER, which most servers require anyway.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=noreply@growpath.net
# EMAIL_PASSWORD=
#
# Test seam only, like D365_AUTHORITY_ORIGIN_OVERRIDE: points Graph, Entra and
# ACS at a local stub. IGNORED IN PRODUCTION.
# EMAIL_ORIGIN_OVERRIDE=http://127.0.0.1:9999
